# Settings for docker/docker-compose.prod.yml. kur.sh / kur.ps1 create this file with random secrets.
# To fill it by hand: copy to .env.production and give every secret a new random value.

# Addresses people use to open the system
PUBLIC_WEB_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:3001"

# Names shown on screen
APP_NAME="Evrakdar"
ORG_NAME="Kurumunuzun Adı"

# Secrets
POSTGRES_PASSWORD=""
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Files stay on this server by default. To use an S3-compatible service instead:
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://s3.example.com"
# S3_BUCKET="documents"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# Leave the password empty to start with the admin, editor and user accounts (password 1234).
# Set it to create a single administrator instead (at least 12 characters).
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_EMAIL=""

# Which address and port each part listens on
WEB_BIND="127.0.0.1:3000"
API_BIND="127.0.0.1:3001"

# Set to 1 only when an HTTPS reverse proxy runs in front of the API
TRUST_PROXY=""
