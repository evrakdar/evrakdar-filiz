# Settings for developing on your own computer. Copy to .env and adjust.
# Never commit .env. Real installations use kur.sh / kur.ps1, which create .env.production.

# --- Database (docker/docker-compose.yml) ---
POSTGRES_DB="evrakdar"
POSTGRES_USER="evrakdar"
POSTGRES_PASSWORD="evrakdar"
DATABASE_URL="postgresql://evrakdar:evrakdar@localhost:5432/evrakdar"
SHADOW_DATABASE_URL="postgresql://evrakdar:evrakdar@localhost:5432/evrakdar_shadow"

# --- File storage ---
# local: files stay on this computer (apps/api/data/files). s3: any S3-compatible service.
STORAGE_DRIVER="local"
STORAGE_DIR="data/files"
# S3_ENDPOINT="https://s3.example.com"
# S3_BUCKET="documents"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# --- Login ---
# Empty in development: a development-only secret is used and a warning is printed.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
LOGIN_RATE_LIMIT_MAX_FAILURES="10"
LOGIN_RATE_LIMIT_MAX_FAILURES_PER_IP="50"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"

# --- API and web ---
API_PORT="3001"
WEB_PORT="3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_DATA_SOURCE="api"
NEXT_PUBLIC_APP_NAME="Evrakdar"
NEXT_PUBLIC_ORG_NAME="Örnek Kolej"

# --- Sample data ---
# true: creates test accounts admin/admin123, editor/editor123, viewer/viewer123 (development only).
SEED_DEMO_USERS="true"
# true: wipes all folders and documents before seeding (development only).
SEED_RESET="false"
