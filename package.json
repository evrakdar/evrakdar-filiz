{
  "name": "evrakdar",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate --workspace=@evrakdar/api",
    "dev:web": "npm --workspace @evrakdar/web run dev",
    "dev:api": "npm --workspace @evrakdar/api run start:dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e:web": "npm --workspace @evrakdar/web run test:e2e",
    "docker:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose --env-file .env -f docker/docker-compose.yml down"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "multer": "^2.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0"
  },
  "description": "Evrakdar Filiz: okullar ve küçük kurumlar için açık kaynak belge yönetimi",
  "author": "Evrakdar <bilgi@evrakdar.com>"
}
